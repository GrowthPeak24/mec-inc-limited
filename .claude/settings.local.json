{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npx next:*)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(rm build-log.txt)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/maybe-update-claude-md.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
